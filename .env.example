# Z.AI API credentials (never commit real keys)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# GLM chat extraction defaults
GLM_MODEL=glm-5.2
GLM_REASONING_EFFORT=high
GLM_MAX_OUTPUT_TOKENS=32768

# Cheap high-recall routing before detailed extraction
SCOUT_MODE=auto
SCOUT_MODEL=glm-4.7-flash
SCOUT_CHUNK_PAGES=10
SCOUT_OVERLAP_PAGES=2
SCOUT_CONTEXT_PAGES=2
SCOUT_MAX_OUTPUT_TOKENS=4096
SCOUT_AUDIT_NEGATIVES=true

# PDF / OCR chunking
PDF_CHUNK_PAGES=20
PDF_OVERLAP_PAGES=2
OCR_CHUNK_PAGES=20

# Reliability
MAX_API_RETRIES=5
REQUEST_TIMEOUT_SECONDS=600

# Optional concurrency (keep low to avoid rate limits)
MAX_WORKERS=1
