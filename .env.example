# LLM provider (GLM / Z.AI by default)
ORG_INTEL_LLM_PROVIDER=glm
ORG_INTEL_GLM_API_KEY=
ORG_INTEL_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ORG_INTEL_GLM_CHEAP_MODEL=glm-4.5-flash
ORG_INTEL_GLM_STRUCTURED_MODEL=glm-4.5-air
ORG_INTEL_GLM_REASONING_MODEL=glm-4-plus
ORG_INTEL_GLM_OCR_MODEL=glm-4.5-flash
ORG_INTEL_GLM_JSON_REPAIR_MODEL=glm-4.5-flash

# Optional OpenAI-compatible fallback
ORG_INTEL_OPENAI_API_KEY=
ORG_INTEL_OPENAI_BASE_URL=https://api.openai.com/v1

# Runtime defaults
ORG_INTEL_MAX_COST_USD=25.0
ORG_INTEL_MAX_DOCUMENTS=200
ORG_INTEL_MAX_PAGES=5000
ORG_INTEL_MAX_SEARCHES=100
ORG_INTEL_MAX_WORKERS=4
ORG_INTEL_OFFICIAL_SOURCES_ONLY=true
ORG_INTEL_USER_AGENT=OrganizationCapitalIntelligence/1.0 (+research; respectful crawler)
ORG_INTEL_REQUEST_TIMEOUT_SECONDS=45
ORG_INTEL_CACHE_DIR=.org_intel_cache
ORG_INTEL_DATABASE_URL=sqlite:///./org_intel.db
ORG_INTEL_LOG_LEVEL=INFO
ORG_INTEL_RESPECT_ROBOTS=true
